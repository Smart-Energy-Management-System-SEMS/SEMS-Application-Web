# URL base del API Gateway (Spring Cloud Gateway, puerto 8089 por defecto)
VITE_API_BASE_URL=http://localhost:8089

# Modo demo: usa datos simulados sin necesidad de backend.
#   true  -> la app funciona con datos de ejemplo (ideal para ver la UI)
#   false -> consume el API Gateway real (VITE_API_BASE_URL)
VITE_DEMO_MODE=true
